[core]
    editor = nvim
    pager = less
    eol = lf

[user]
    name = Matheus Sampaio
    email = matheus@sampaio.us
    signingkey = 552FE4A4135B4D20

[commit]
    verbose = true
    gpgsign = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true

[rebase]
    stat = true
    instructionFormat = %s [%an - %ar]
    autoSquash = true
    autoStash = true

[github]
    user = matheussampaio

[checkout]
    defaultRemote = origin

[init]
    defaultBranch = main

[pull]
    rebase = true

[color]
    ui = auto

[alias]
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)%an <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order

[push]
    default = simple
    autoSetupRemote = true
    followTags = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[fetch]
    prune = true
    pruneTags = true
    all = true

[help]
    autocorrect = prompt

[rerere]
    enabled = true
    autoupdate = true

[merge]
    conflictstyle = zdiff3

[gpg]
	program = gpg

[includeIf "gitdir:~/git/quaestor/"]
    path = config-work
